# Matrix bot account (create a separate user for the bot)
MATRIX_HOMESERVER_URL=https://matrix.example.org
MATRIX_ACCESS_TOKEN=
# The only user whose calls are accepted
MATRIX_ALLOWED_USER=@you:example.org
# Name of the room the bot creates for you on first start
#MATRIX_ROOM_NAME=Discord voice

# Discord bot (needs View Channel, Connect and Speak in the voice channel)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=

# WebRTC networking towards your Matrix client
# UDP ports the bot uses for media; forward them if the bot is behind NAT
#WEBRTC_PORT_RANGE=40000-40100
# Public IP to advertise as an extra host candidate (comma-separated)
#WEBRTC_PUBLIC_IP=
# Use the homeserver's TURN server (Synapse turn_uris); default true
#USE_HOMESERVER_TURN=true
# Comma-separated STUN servers; empty to disable
#STUN_SERVERS=stun:stun.l.google.com:19302

#LOG_LEVEL=info
